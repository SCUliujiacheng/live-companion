{
  "name": "live-companion",
  "version": "0.2.0",
  "main": "desktop/main.js",
  "author": "SCUliujiacheng",
  "private": true,
  "description": "Bilibili live voice and chat companion with configurable AI APIs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SCUliujiacheng/live-companion.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "package": "node scripts/package.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --win --dir",
    "desktop:dist": "npm run desktop:build && electron-builder --win"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "jose": "6.2.12"
  }
}
